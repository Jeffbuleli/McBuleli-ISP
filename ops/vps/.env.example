# Copy to ops/vps/.env on the VPS (never commit).

POSTGRES_USER=isp_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=isp_billing

JWT_SECRET=replace_with_a_long_random_secret
NETWORK_NODE_SECRET_KEY=replace_with_a_unique_32_plus_character_secret

PLATFORM_PUBLIC_BASE_URL=https://mcbuleli.live
PUBLIC_API_BASE_URL=https://mcbuleli.live
CORS_ORIGINS=https://mcbuleli.live

PAWAPAY_API_TOKEN=
PAWAPAY_API_BASE_URL=https://api.pawapay.io
PAWAPAY_CALLBACK_SECRET=
PAWAPAY_PLATFORM_CALLBACK_SECRET=

PLATFORM_TRIAL_DAYS=30
PLATFORM_USD_TO_CDF=2800
PLATFORM_SAAS_BILLING_DAYS=30
TID_REMINDER_INTERVAL_MIN=30
NOTIFICATION_WORKER_INTERVAL_SEC=60
NOTIFICATION_MAX_ATTEMPTS=5
FREERADIUS_SYNC_ENABLED=false
